{
  "name": "create-prodforge",
  "version": "0.0.0",
  "description": "Scaffold production-ready Node.js + TypeScript backends: Express, Fastify or Hono, Prisma, Drizzle or Mongoose, Docker, PM2, CI, auth, Redis and OpenTelemetry.",
  "keywords": [
    "create",
    "create-app",
    "scaffold",
    "generator",
    "cli",
    "template",
    "typescript",
    "node",
    "backend",
    "api",
    "express",
    "fastify",
    "hono",
    "prisma",
    "drizzle",
    "mongoose",
    "docker"
  ],
  "license": "MIT",
  "author": "Keyan",
  "homepage": "https://github.com/Keyan-dev/create-prodforge#readme",
  "bugs": {
    "url": "https://github.com/Keyan-dev/create-prodforge/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Keyan-dev/create-prodforge.git"
  },
  "type": "module",
  "bin": {
    "create-prodforge": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm build && vitest run --config vitest.e2e.config.ts",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish",
    "try:engine": "tsx scripts/try-engine.ts"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "citty": "^0.2.2",
    "eta": "^4.6.0",
    "picocolors": "^1.1.1",
    "tinyexec": "^1.3.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsdown": "^0.23.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
