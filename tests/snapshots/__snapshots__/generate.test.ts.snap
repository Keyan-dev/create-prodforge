  "src/app.ts": "import { bodyLimit } from 'hono/body-limit';
import { cors } from 'hono/cors';
import { HTTPException } from 'hono/http-exception';
import { requestId } from 'hono/request-id';
import { secureHeaders } from 'hono/secure-headers';
import { rateLimiter } from 'hono-rate-limiter';
import { env } from './config/env';
import { type AppEnv, createRouter } from './lib/hono';
import { errorHandler, notFound } from './middleware/error-handler';
import { requestLogger } from './middleware/request-logger';
import { healthRoutes } from './modules/health/health.routes';
import { docsRoutes } from './modules/docs/docs.routes';
import { authRoutes } from './modules/auth/auth.routes';
import { usersRoutes } from './modules/users/users.routes';

/** Build the app without listening, so tests can drive it with \`app.request()\`. */
export function createApp() {
  const app = createRouter();

  // Reuses an incoming X-Request-Id (from a proxy) or creates one, and echoes it back.
  app.use(requestId());
  app.use(requestLogger);
  app.use(secureHeaders());
  // Health checks stay outside CORS and rate limiting.
  app.route('/', healthRoutes);

  app.use(cors({ origin: env.CORS_ORIGIN === '*' ? '*' : env.CORS_ORIGIN.split(',') }));
  app.use(
    rateLimiter<AppEnv>({
      windowMs: 60_000,
      limit: env.RATE_LIMIT_PER_MINUTE,
      standardHeaders: 'draft-7',
      // c.env is the Node request under @hono/node-server; app.request() in tests has none.
      keyGenerator: (c) =>
        (c.env as AppEnv['Bindings'] | undefined)?.incoming.socket.remoteAddress ?? 'unknown',
    }),
  );
  app.use(
    bodyLimit({
      maxSize: env.BODY_LIMIT_KB * 1024,
      onError: () => {
        throw new HTTPException(413, { message: 'Request body too large' });
      },
    }),
  );

  app.route('/', docsRoutes);
  app.route('/auth', authRoutes);
  app.route('/users', usersRoutes);
  app.notFound(notFound);
  app.onError(errorHandler);

  return app;
}
",
  "src/lib/jwt.ts": "import { jwtVerify, SignJWT } from 'jose';
import { env } from '../config/env';

const secret = new TextEncoder().encode(env.JWT_SECRET);
const ISSUER = 'api';

export type TokenType = 'access' | 'refresh';

export interface TokenPair {
  accessToken: string;
  refreshToken: string;
  tokenType: 'Bearer';
  expiresIn: string;
}

/** Sign a short-lived access token or a longer-lived refresh token for this account id. */
function sign(subject: string, type: TokenType) {
  return new SignJWT({ type })
    .setProtectedHeader({ alg: 'HS256' })
    .setSubject(subject)
    .setIssuer(ISSUER)
    .setIssuedAt()
    .setExpirationTime(type === 'access' ? env.JWT_ACCESS_TTL : env.JWT_REFRESH_TTL)
    .sign(secret);
}

export async function issueTokens(subject: string): Promise<TokenPair> {
  const [accessToken, refreshToken] = await Promise.all([
    sign(subject, 'access'),
    sign(subject, 'refresh'),
  ]);
  return { accessToken, refreshToken, tokenType: 'Bearer', expiresIn: env.JWT_ACCESS_TTL };
}

/** The account id in a valid token of this type, or null if it's invalid, expired or the wrong type. */
export async function verifyToken(token: string, type: TokenType): Promise<string | null> {
  try {
    const { payload } = await jwtVerify(token, secret, { issuer: ISSUER, algorithms: ['HS256'] });
    return payload.type === type && payload.sub ? payload.sub : null;
  } catch {
    return null;
  }
}
",
  "src/lib/password.ts": "import { randomBytes, scrypt, timingSafeEqual } from 'node:crypto';
import { promisify } from 'node:util';

const scryptAsync = promisify(scrypt) as (
  password: string,
  salt: Buffer,
  keylen: number,
) => Promise<Buffer>;

const KEY_LENGTH = 64;

/**
 * Hash a password with scrypt (built into Node, no native dependency) and a random salt.
 * The result stores both as \`scrypt$<salt>$<hash>\` in base64.
 */
export async function hashPassword(password: string): Promise<string> {
  const salt = randomBytes(16);
  const hash = await scryptAsync(password, salt, KEY_LENGTH);
  return \`scrypt$\${salt.toString('base64')}$\${hash.toString('base64')}\`;
}

/** Check a password against a stored hash, in constant time. */
export async function verifyPassword(password: string, stored: string): Promise<boolean> {
  const [scheme, salt, hash] = stored.split('$');
  if (scheme !== 'scrypt' || !salt || !hash) return false;
  const expected = Buffer.from(hash, 'base64');
  const actual = await scryptAsync(password, Buffer.from(salt, 'base64'), expected.length);
  return timingSafeEqual(actual, expected);
}
",
  "src/modules/auth/auth.model.ts": "import { model, Schema } from 'mongoose';

const accountSchema = new Schema(
  {
    email: { type: String, required: true, unique: true },
    passwordHash: { type: String, required: true },
  },
  { timestamps: { createdAt: true, updatedAt: false } },
);

export const AccountModel = model('Account', accountSchema);
",
  "src/modules/auth/auth.openapi.ts": "import { z } from 'zod';
import type { ZodOpenApiOperationObject, ZodOpenApiPathsObject } from 'zod-openapi';
import { errorResponse, json } from '../../openapi/schemas';
import { CredentialsSchema, RefreshSchema } from './auth.schema';

const TokensSchema = z
  .object({
    accessToken: z.string(),
    refreshToken: z.string(),
    tokenType: z.literal('Bearer'),
    expiresIn: z.string(),
  })
  .meta({ id: 'Tokens' });

const tokens = (description: string) => ({ description, content: json(TokensSchema) });
const invalid = errorResponse('Invalid request body');
const tagged = (operation: ZodOpenApiOperationObject) => ({ tags: ['auth'], ...operation });

/** OpenAPI paths for the auth routes, added to the document in src/openapi/document.ts. */
export const authPaths: ZodOpenApiPathsObject = {
  '/auth/register': {
    post: tagged({
      summary: 'Create an account and get tokens',
      requestBody: { content: json(CredentialsSchema) },
      responses: {
        '201': tokens('Registered'),
        '400': invalid,
        '409': errorResponse('Email already registered'),
      },
    }),
  },
  '/auth/login': {
    post: tagged({
      summary: 'Log in and get tokens',
      requestBody: { content: json(CredentialsSchema) },
      responses: {
        '200': tokens('Logged in'),
        '400': invalid,
        '401': errorResponse('Wrong email or password'),
      },
    }),
  },
  '/auth/refresh': {
    post: tagged({
      summary: 'Exchange a refresh token for new tokens',
      requestBody: { content: json(RefreshSchema) },
      responses: { '200': tokens('New tokens'), '401': errorResponse('Invalid refresh token') },
    }),
  },
  '/auth/me': {
    get: tagged({
      summary: 'The logged-in account',
      security: [{ bearerAuth: [] }],
      responses: {
        '200': {
          description: 'The account',
          content: json(z.object({ id: z.string(), email: z.email() })),
        },
        '401': errorResponse('Missing or invalid access token'),
      },
    }),
  },
};
",
  "src/modules/auth/auth.repository.ts": "import { isValidObjectId, mongo, type Types } from 'mongoose';
import { AccountModel } from './auth.model';
import { type Account, AccountExistsError, type AccountsRepository } from './auth.schema';

interface AccountDocument {
  _id: Types.ObjectId;
  email: string;
  passwordHash: string;
  createdAt: Date;
}

function toAccount({ _id, email, passwordHash, createdAt }: AccountDocument): Account {
  return { id: _id.toString(), email, passwordHash, createdAt };
}

export const accountsRepository: AccountsRepository = {
  async findByEmail(email) {
    const doc = await AccountModel.findOne({ email }).lean();
    return doc && toAccount(doc);
  },

  async findById(id) {
    if (!isValidObjectId(id)) return null;
    const doc = await AccountModel.findById(id).lean();
    return doc && toAccount(doc);
  },

  async create(data) {
    try {
      return toAccount((await AccountModel.create(data)).toObject());
    } catch (error) {
      // 11000: duplicate key, here the unique email index.
      if (error instanceof mongo.MongoServerError && error.code === 11000) {
        throw new AccountExistsError();
      }
      throw error;
    }
  },
};
",
  "src/modules/auth/auth.routes.ts": "import { createMiddleware } from 'hono/factory';
import { type AppEnv, createRouter } from '../../lib/hono';
import { CredentialsSchema, RefreshSchema } from './auth.schema';
import { type AuthUser, authService } from './auth.service';

/** Rejects a request without a valid access token (401); the account is in \`c.get('user')\`. */
export const requireAuth = createMiddleware<AppEnv & { Variables: { user: AuthUser } }>(
  async (c, next) => {
    c.set('user', await authService.authenticate(c.req.header('authorization')));
    await next();
  },
);

export const authRoutes = createRouter()
  .post('/register', async (c) =>
    c.json(await authService.register(CredentialsSchema.parse(await c.req.json())), 201),
  )
  .post('/login', async (c) =>
    c.json(await authService.login(CredentialsSchema.parse(await c.req.json()))),
  )
  .post('/refresh', async (c) =>
    c.json(await authService.refresh(RefreshSchema.parse(await c.req.json()).refreshToken)),
  )
  .get('/me', requireAuth, (c) => c.json(c.get('user')));
",
  "src/modules/auth/auth.schema.ts": "import { z } from 'zod';

/** Request body for registering and logging in. */
export const CredentialsSchema = z.object({
  email: z.email().toLowerCase(),
  password: z.string().min(8).max(200),
});

/** Request body for exchanging a refresh token for new tokens. */
export const RefreshSchema = z.object({ refreshToken: z.string().min(1) });

export type Credentials = z.infer<typeof CredentialsSchema>;

export interface Account {
  id: string;
  email: string;
  passwordHash: string;
  createdAt: Date;
}

/** Storage for accounts. \`auth.repository.ts\` implements it for the chosen database. */
export interface AccountsRepository {
  findByEmail(email: string): Promise<Account | null>;
  findById(id: string): Promise<Account | null>;
  /** Throws \`AccountExistsError\` if the email is already registered. */
  create(data: { email: string; passwordHash: string }): Promise<Account>;
}

/** An auth failure the error handler sends with its status (401 or 409). */
export class AuthError extends Error {
  readonly expose = true;

  constructor(
    readonly status: 401 | 409,
    message: string,
  ) {
    super(message);
    this.name = 'AuthError';
  }
}

export class AccountExistsError extends AuthError {
  constructor() {
    super(409, 'An account with this email already exists');
  }
}
",
  "src/modules/auth/auth.service.ts": "import { issueTokens, verifyToken } from '../../lib/jwt';
import { hashPassword, verifyPassword } from '../../lib/password';
import { accountsRepository } from './auth.repository';
import { AuthError, type Credentials } from './auth.schema';

const invalidCredentials = () => new AuthError(401, 'Invalid email or password');

/** Framework-independent auth logic; the routes only parse requests and send responses. */
export const authService = {
  async register({ email, password }: Credentials) {
    const account = await accountsRepository.create({
      email,
      passwordHash: await hashPassword(password),
    });
    return issueTokens(account.id);
  },

  async login({ email, password }: Credentials) {
    const account = await accountsRepository.findByEmail(email);
    if (!account || !(await verifyPassword(password, account.passwordHash))) {
      throw invalidCredentials();
    }
    return issueTokens(account.id);
  },

  /** Refresh tokens are stateless JWTs: valid until they expire (see the README). */
  async refresh(refreshToken: string) {
    const id = await verifyToken(refreshToken, 'refresh');
    if (!id || !(await accountsRepository.findById(id))) {
      throw new AuthError(401, 'Invalid refresh token');
    }
    return issueTokens(id);
  },

  /** The account behind an \`Authorization: Bearer <access token>\` header. */
  async authenticate(authorization: string | undefined) {
    const token = authorization?.match(/^Bearer (.+)$/i)?.[1];
    const id = token && (await verifyToken(token, 'access'));
    const account = id ? await accountsRepository.findById(id) : null;
    if (!account) throw new AuthError(401, 'Authentication required');
    return { id: account.id, email: account.email };
  },
};

export type AuthUser = Awaited<ReturnType<typeof authService.authenticate>>;
",
  "src/modules/users/users.schema.ts": "import { z } from 'zod';

/** Request body for creating a user. */
export const CreateUserSchema = z.object({
  email: z.email().toLowerCase(),
  name: z.string().trim().min(1).max(100),
});

/** Request body for updating a user: any subset of the create fields. */
export const UpdateUserSchema = CreateUserSchema.partial();

/** Query string for listing users. */
export const ListUsersSchema = z.object({
  limit: z.coerce.number().int().min(1).max(100).default(20),
  offset: z.coerce.number().int().min(0).default(0),
});

export type CreateUser = z.infer<typeof CreateUserSchema>;
export type UpdateUser = z.infer<typeof UpdateUserSchema>;
export type ListUsers = z.infer<typeof ListUsersSchema>;

export interface User {
  id: string;
  email: string;
  name: string;
  createdAt: Date;
  updatedAt: Date;
}

/** Storage for users. \`users.repository.ts\` implements it for the chosen database. */
export interface UsersRepository {
  list(query: ListUsers): Promise<User[]>;
  findById(id: string): Promise<User | null>;
  /** Throws \`EmailTakenError\` if the email is already used. */
  create(data: CreateUser): Promise<User>;
  /** Returns null if there is no such user. Throws \`EmailTakenError\` on a duplicate email. */
  update(id: string, data: UpdateUser): Promise<User | null>;
  /** Returns false if there is no such user. */
  remove(id: string): Promise<boolean>;
}

/** Another user already has this email. The error handler sends it as a 409. */
export class EmailTakenError extends Error {
  readonly status = 409;
  readonly expose = true;

  constructor() {
    super('A user with this email already exists');
    this.name = 'EmailTakenError';
  }
}
",
  "tests/auth.test.ts": "import { beforeEach, describe, expect, it, vi } from 'vitest';
import { createApp } from '../src/app';
import { memoryAccountsRepository } from './support/memory-accounts-repository';

// The routes run against in-memory accounts, so these tests need no database.
vi.mock('../src/modules/auth/auth.repository', async () => ({
  accountsRepository: (await import('./support/memory-accounts-repository'))
    .memoryAccountsRepository,
}));

interface Tokens {
  accessToken: string;
  refreshToken: string;
}

const ada = { email: 'ada@example.com', password: 'correct horse battery' };

const app = createApp();

async function send(method: string, path: string, body?: unknown, headers = {}) {
  const response = await app.request(path, {
    method,
    headers: { 'content-type': 'application/json', ...headers },
    ...(body !== undefined && { body: JSON.stringify(body) }),
  });
  return { status: response.status, body: (await response.json()) as unknown };
}

describe('auth', () => {
  beforeEach(() => memoryAccountsRepository.reset());

  it('registers, logs in, refreshes and reads the account', async () => {
    const registered = await send('POST', '/auth/register', ada);
    expect(registered.status).toBe(201);
    expect(registered.body).toMatchObject({ tokenType: 'Bearer' });

    const login = await send('POST', '/auth/login', ada);
    expect(login.status).toBe(200);
    const { accessToken, refreshToken } = login.body as Tokens;

    const me = await send('GET', '/auth/me', undefined, { authorization: \`Bearer \${accessToken}\` });
    expect(me.status).toBe(200);
    expect(me.body).toMatchObject({ email: ada.email });

    const refreshed = await send('POST', '/auth/refresh', { refreshToken });
    expect(refreshed.status).toBe(200);
    expect(refreshed.body).toHaveProperty('accessToken');
  });

  it('rejects a wrong password, a duplicate email and bad input', async () => {
    await send('POST', '/auth/register', ada);

    expect((await send('POST', '/auth/login', { ...ada, password: 'wrong-password' })).status).toBe(
      401,
    );
    expect((await send('POST', '/auth/register', ada)).status).toBe(409);
    const invalid = await send('POST', '/auth/register', { email: 'nope', password: 'x' });
    expect(invalid.status).toBe(400);
  });

  it('requires a valid access token', async () => {
    const { body } = await send('POST', '/auth/register', ada);
    const { refreshToken } = body as Tokens;

    expect((await send('GET', '/auth/me')).status).toBe(401);
    const forged = await send('GET', '/auth/me', undefined, { authorization: 'Bearer nope' });
    expect(forged.status).toBe(401);
    // A refresh token is not an access token.
    const wrongType = { authorization: \`Bearer \${refreshToken}\` };
    expect((await send('GET', '/auth/me', undefined, wrongType)).status).toBe(401);
  });
});
",
}
`;

