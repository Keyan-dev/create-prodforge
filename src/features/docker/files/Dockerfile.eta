# syntax=docker/dockerfile:1

ARG NODE_VERSION=<%= it.cfg.node %>

FROM node:${NODE_VERSION}-alpine AS base
WORKDIR /app
<% if (it.pm.setup) { -%>
RUN <%= it.pm.setup %>
<% } -%>

# All dependencies, for building.
FROM base AS deps
COPY package.json <%= it.pm.lockfile %> ./
# @slot:install-files
RUN <%= it.pm.install %>

FROM deps AS build
COPY . .
RUN <%= it.pm.build %>

# Production dependencies only, for the final image. Scripts are skipped: install hooks such as
# code generation already ran in the deps stage, and their tools are dev dependencies.
FROM base AS prod-deps
COPY package.json <%= it.pm.lockfile %> ./
RUN <%= it.pm.installProd %>

FROM node:${NODE_VERSION}-alpine AS runtime
ENV NODE_ENV=production
WORKDIR /app
COPY --from=prod-deps --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/dist ./dist
COPY --chown=node:node package.json ./
USER node
EXPOSE 3000
HEALTHCHECK --interval=10s --timeout=3s --start-period=10s --retries=3 \
  CMD wget -qO- "http://127.0.0.1:${PORT:-3000}/health" || exit 1
# Run node directly (not via a package manager) so it receives SIGTERM for graceful shutdown.
CMD ["node", "dist/server.js"]
