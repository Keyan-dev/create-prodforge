{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "schedule": ["before 6am on monday"],
  "packageRules": [
    { "matchUpdateTypes": ["patch", "minor"], "groupName": "non-major dependencies" }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Versions used in generated projects",
      "managerFilePatterns": ["/^src/core/versions\\.ts$/"],
      "matchStrings": ["'(?<depName>[^']+)': '(?<currentValue>[^']+)',"],
      "datasourceTemplate": "npm"
    }
  ]
}
