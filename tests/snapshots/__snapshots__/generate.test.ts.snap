    "src/app.ts": "import { randomUUID } from 'node:crypto';
import cors from 'cors';
import express from 'express';
import { rateLimit } from 'express-rate-limit';
import helmet from 'helmet';
import { pinoHttp } from 'pino-http';
import { env } from './config/env';
import { logger } from './lib/logger';
import { errorHandler, notFound } from './middleware/error-handler';
import { healthRouter } from './modules/health/health.routes';

/** Build the app without listening, so tests can drive it directly. */
export function createApp() {
  const app = express();

  app.use(
    pinoHttp({
      logger,
      // Reuse an incoming X-Request-Id (from a proxy) or create one, and echo it back.
      genReqId: (req, res) => {
        const id = req.headers['x-request-id']?.toString() || randomUUID();
        res.setHeader('x-request-id', id);
        return id;
      },
      autoLogging: { ignore: (req) => req.url === '/health' || req.url === '/ready' },
    }),
  );
  app.use(helmet());
  // Health checks stay outside CORS and rate limiting.
  app.use(healthRouter);

  app.use(cors({ origin: env.CORS_ORIGIN === '*' ? '*' : env.CORS_ORIGIN.split(',') }));
  app.use(
    rateLimit({
      windowMs: 60_000,
      limit: env.RATE_LIMIT_PER_MINUTE,
      standardHeaders: 'draft-8',
      legacyHeaders: false,
    }),
  );
  app.use(express.json({ limit: env.BODY_LIMIT }));

  app.use(notFound);
  app.use(errorHandler);

  return app;
}
",
    "src/config/env.ts": "import { z } from 'zod';

/** Every environment variable the app reads, validated once at startup. */
const EnvSchema = z.object({
  NODE_ENV: z.enum(['development', 'test', 'production']).default('development'),
  PORT: z.coerce.number().int().positive().default(3000),
  LOG_LEVEL: z.enum(['fatal', 'error', 'warn', 'info', 'debug', 'trace', 'silent']).optional(),
  SHUTDOWN_TIMEOUT_MS: z.coerce.number().int().positive().default(10_000),
  CORS_ORIGIN: z.string().default('*'),
  RATE_LIMIT_PER_MINUTE: z.coerce.number().int().positive().default(100),
  BODY_LIMIT: z.string().default('100kb'),
});

const parsed = EnvSchema.safeParse(process.env);
if (!parsed.success) {
  console.error(\`Invalid environment variables:\\n\${z.prettifyError(parsed.error)}\`);
  process.exit(1);
}

export const env = parsed.data;
export type Env = typeof env;
",
    "src/lib/logger.ts": "import { pino } from 'pino';
import { env } from '../config/env';

const defaultLevel = { development: 'debug', test: 'silent', production: 'info' } as const;

/** Pretty output in development, JSON lines everywhere else. */
export const logger = pino({
  level: env.LOG_LEVEL ?? defaultLevel[env.NODE_ENV],
  redact: ['req.headers.authorization', 'req.headers.cookie', 'res.headers["set-cookie"]'],
  ...(env.NODE_ENV === 'development' && { transport: { target: 'pino-pretty' } }),
});
",
    "src/lib/readiness.ts": "/** A dependency the app needs before it can serve traffic (database, cache, …). */
export interface ReadinessCheck {
  name: string;
  check: () => Promise<void>;
}

const checks: ReadinessCheck[] = [];

let shuttingDown = false;

/** Called on SIGTERM so load balancers stop sending traffic before the server closes. */
export function markShuttingDown() {
  shuttingDown = true;
}

/** Run every check. \`ready\` is false while shutting down or if any check fails. */
export async function readiness() {
  if (shuttingDown) return { ready: false, checks: { shutdown: 'shutting down' } };

  const results = await Promise.allSettled(checks.map(({ check }) => check()));
  const report = Object.fromEntries(
    checks.map(({ name }, index) => [
      name,
      results[index]?.status === 'fulfilled' ? 'ok' : 'failing',
    ]),
  );
  return { ready: Object.values(report).every((status) => status === 'ok'), checks: report };
}
",
    "src/middleware/error-handler.ts": "import type { ErrorRequestHandler, RequestHandler } from 'express';
import { z } from 'zod';

/** Throw this from a handler to send a specific status and message. */
export class HttpError extends Error {
  constructor(
    readonly status: number,
    message: string,
    readonly details?: unknown,
  ) {
    super(message);
    this.name = 'HttpError';
  }
}

export const notFound: RequestHandler = (req, _res, next) => {
  next(new HttpError(404, \`Cannot \${req.method} \${req.path}\`));
};

/** Errors that come from body parsing etc. carry a safe-to-show status and message. */
function isExposedError(error: unknown): error is { status: number; message: string } {
  return (
    typeof error === 'object' &&
    error !== null &&
    'status' in error &&
    typeof error.status === 'number' &&
    'expose' in error &&
    error.expose === true
  );
}

/** One JSON error shape for everything. 5xx details are logged, never sent to the client. */
export const errorHandler: ErrorRequestHandler = (error, req, res, _next) => {
  let status = 500;
  let message = 'Internal Server Error';
  let details: unknown;

  if (error instanceof HttpError) {
    ({ status, message, details } = error);
  } else if (error instanceof z.ZodError) {
    status = 400;
    message = 'Validation failed';
    details = z.flattenError(error);
  } else if (isExposedError(error)) {
    ({ status, message } = error);
  }

  if (status >= 500) req.log.error({ err: error }, 'Request failed');

  res.status(status).json({ error: { message, details, requestId: req.id } });
};
",
    "src/modules/health/health.routes.ts": "import { Router } from 'express';
import { readiness } from '../../lib/readiness';

export const healthRouter = Router();

/** Liveness: the process is up. Used by the Docker HEALTHCHECK. */
healthRouter.get('/health', (_req, res) => {
  res.json({ status: 'ok' });
});

/** Readiness: dependencies are reachable and the app isn't shutting down. */
healthRouter.get('/ready', async (_req, res) => {
  const result = await readiness();
  res.status(result.ready ? 200 : 503).json(result);
});
",
    "src/server.ts": "import { createApp } from './app';
import { env } from './config/env';
import { logger } from './lib/logger';
import { markShuttingDown } from './lib/readiness';

const server = createApp().listen(env.PORT, () => {
  logger.info(\`Listening on http://localhost:\${env.PORT}\`);
  // Tells PM2 (wait_ready) that this worker can take traffic.
  process.send?.('ready');
});

let shuttingDown = false;

/** Stop taking new connections, let open requests finish, close resources, then exit. */
function shutdown(reason: string, exitCode = 0) {
  if (shuttingDown) return;
  shuttingDown = true;
  logger.info({ reason }, 'Shutting down');
  markShuttingDown();

  const timer = setTimeout(() => {
    logger.error('Open connections did not close in time, exiting');
    process.exit(1);
  }, env.SHUTDOWN_TIMEOUT_MS);
  timer.unref();

  server.close(async (error) => {
    if (error) logger.error({ err: error }, 'Error while closing the server');
    process.exit(error ? 1 : exitCode);
  });
}

process.once('SIGTERM', () => shutdown('SIGTERM'));
process.once('SIGINT', () => shutdown('SIGINT'));
process.on('unhandledRejection', (reason) => {
  logger.fatal({ err: reason }, 'Unhandled promise rejection');
  shutdown('unhandledRejection', 1);
});
process.on('uncaughtException', (error) => {
  logger.fatal({ err: error }, 'Uncaught exception');
  shutdown('uncaughtException', 1);
});
",
    "tests/app.test.ts": "import request from 'supertest';
import { describe, expect, it } from 'vitest';
import { createApp } from '../src/app';

describe('app', () => {
  it('returns a JSON 404 with the request id', async () => {
    const response = await request(createApp()).get('/nope');

    expect(response.status).toBe(404);
    expect(response.body.error).toMatchObject({ message: 'Cannot GET /nope' });
    expect(response.body.error.requestId).toBe(response.headers['x-request-id']);
  });

  it('reuses an incoming X-Request-Id', async () => {
    const response = await request(createApp()).get('/health').set('x-request-id', 'abc-123');

    expect(response.headers['x-request-id']).toBe('abc-123');
  });

  it('rejects malformed JSON with a 400', async () => {
    const response = await request(createApp())
      .post('/anything')
      .set('content-type', 'application/json')
      .send('{"oops"');

    expect(response.status).toBe(400);
  });

  it('sets security headers', async () => {
    const response = await request(createApp()).get('/health');

    expect(response.headers['x-content-type-options']).toBe('nosniff');
    expect(response.headers['x-powered-by']).toBeUndefined();
  });
});
",
    "tests/health.test.ts": "import request from 'supertest';
import { describe, expect, it } from 'vitest';
import { createApp } from '../src/app';

describe('health', () => {
  it('GET /health responds with ok', async () => {
    const response = await request(createApp()).get('/health');

    expect(response.status).toBe(200);
    expect(response.body).toEqual({ status: 'ok' });
  });

  it('GET /ready reports each check', async () => {
    const response = await request(createApp()).get('/ready');

    expect(response.status).toBe(200);
    expect(response.body).toMatchObject({ ready: true });
  });
});
",
    "tsconfig.json": "{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "tests", "*.config.ts"]
}
",
    "tsdown.config.ts": "import { defineConfig } from 'tsdown';

export default defineConfig({
  entry: ['src/server.ts'],
  format: 'esm',
  platform: 'node',
  target: 'node24',
  fixedExtension: false,
  clean: true,
});
",
    "vitest.config.ts": "import { defineConfig } from 'vitest/config';

export default defineConfig({
  test: {
    include: ['tests/**/*.test.ts'],
    coverage: { provider: 'v8', include: ['src/**'] },
  },
});
",
