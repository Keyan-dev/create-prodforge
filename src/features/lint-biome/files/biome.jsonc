{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  // Skip whatever .gitignore skips (dist, coverage, generated clients).
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      // Everything except lockfiles and generated code.
      "**",
      // @slot:ignore
      "!pnpm-lock.yaml"
    ]
  },
  "formatter": { "indentStyle": "space", "lineWidth": 100 },
  "javascript": { "formatter": { "quoteStyle": "single" } },
  // The recommended rules; `biome check --write` also sorts imports.
  "linter": { "enabled": true }
}
