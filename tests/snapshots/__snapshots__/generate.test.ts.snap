  "src/app.ts": "import { randomUUID } from 'node:crypto';
import cors from 'cors';
import express from 'express';
import { rateLimit } from 'express-rate-limit';
import helmet from 'helmet';
import { pinoHttp } from 'pino-http';
import { env } from './config/env';
import { logger } from './lib/logger';
import { errorHandler, notFound } from './middleware/error-handler';
import { healthRouter } from './modules/health/health.routes';
import { docsRouter } from './modules/docs/docs.routes';
import { usersRouter } from './modules/users/users.routes';

/** Build the app without listening, so tests can drive it directly. */
export function createApp() {
  const app = express();

  app.use(
    pinoHttp({
      logger,
      // Reuse an incoming X-Request-Id (from a proxy) or create one, and echo it back.
      genReqId: (req, res) => {
        const id = req.headers['x-request-id']?.toString() || randomUUID();
        res.setHeader('x-request-id', id);
        return id;
      },
      autoLogging: { ignore: (req) => req.url === '/health' || req.url === '/ready' },
    }),
  );
  app.use(helmet());
  // Health checks stay outside CORS and rate limiting.
  app.use(healthRouter);

  app.use(cors({ origin: env.CORS_ORIGIN === '*' ? '*' : env.CORS_ORIGIN.split(',') }));
  app.use(
    rateLimit({
      windowMs: 60_000,
      limit: env.RATE_LIMIT_PER_MINUTE,
      standardHeaders: 'draft-8',
      legacyHeaders: false,
    }),
  );
  app.use(express.json({ limit: env.BODY_LIMIT_KB * 1024 }));

  app.use(docsRouter);
  app.use('/users', usersRouter);
  app.use(notFound);
  app.use(errorHandler);

  return app;
}
",
  "src/config/env.ts": "import { z } from 'zod';

/** Every environment variable the app reads, validated once at startup. */
const EnvSchema = z.object({
  NODE_ENV: z.enum(['development', 'test', 'production']).default('development'),
  PORT: z.coerce.number().int().positive().default(3000),
  LOG_LEVEL: z.enum(['fatal', 'error', 'warn', 'info', 'debug', 'trace', 'silent']).optional(),
  SHUTDOWN_TIMEOUT_MS: z.coerce.number().int().positive().default(10_000),
  CORS_ORIGIN: z.string().default('*'),
  RATE_LIMIT_PER_MINUTE: z.coerce.number().int().positive().default(100),
  BODY_LIMIT_KB: z.coerce.number().int().positive().default(100),
  DATABASE_URL: z.url({ protocol: /^mongodb(\\+srv)?$/ }),
});

const parsed = EnvSchema.safeParse(process.env);
if (!parsed.success) {
  console.error(\`Invalid environment variables:\\n\${z.prettifyError(parsed.error)}\`);
  process.exit(1);
}

export const env = parsed.data;
export type Env = typeof env;
",
  "src/db/client.ts": "import mongoose from 'mongoose';
import { env } from '../config/env';
import { addReadinessCheck } from '../lib/readiness';

async function ping() {
  const { db } = mongoose.connection;
  if (!db) throw new Error('Not connected to MongoDB');
  await db.admin().ping();
}

/**
 * Called once at startup: connect (failing fast if MongoDB can't be reached), build model
 * indexes, then report the connection in /ready.
 */
export async function connectDatabase() {
  await mongoose.connect(env.DATABASE_URL, { serverSelectionTimeoutMS: 5000 });
  // Wait for indexes (such as unique constraints) so they hold from the first request.
  await Promise.all(mongoose.modelNames().map((name) => mongoose.model(name).init()));
  addReadinessCheck('database', ping);
}

export async function disconnectDatabase() {
  await mongoose.disconnect();
}
",
  "src/modules/users/users.model.ts": "import { model, Schema } from 'mongoose';

const userSchema = new Schema(
  {
    email: { type: String, required: true, unique: true },
    name: { type: String, required: true },
  },
  { timestamps: true },
);

export const UserModel = model('User', userSchema);
",
  "src/modules/users/users.openapi.ts": "import { z } from 'zod';
import type { ZodOpenApiOperationObject, ZodOpenApiPathsObject } from 'zod-openapi';
import { errorResponse, json } from '../../openapi/schemas';
import { CreateUserSchema, ListUsersSchema, UpdateUserSchema } from './users.schema';

const UserSchema = z
  .object({
    id: z.string(),
    email: z.email(),
    name: z.string(),
    createdAt: z.iso.datetime(),
    updatedAt: z.iso.datetime(),
  })
  .meta({ id: 'User' });

const byId = { path: z.object({ id: z.string() }) };
const notFound = errorResponse('No user with this id');
const invalid = errorResponse('Invalid request body or query');
const emailTaken = errorResponse('Another user already has this email');

const tagged = (operation: ZodOpenApiOperationObject) => ({ tags: ['users'], ...operation });

/** OpenAPI paths for the users routes, added to the document in src/openapi/document.ts. */
export const usersPaths: ZodOpenApiPathsObject = {
  '/users': {
    get: tagged({
      summary: 'List users',
      requestParams: { query: ListUsersSchema },
      responses: {
        '200': { description: 'A page of users', content: json(z.array(UserSchema)) },
        '400': invalid,
      },
    }),
    post: tagged({
      summary: 'Create a user',
      requestBody: { content: json(CreateUserSchema) },
      responses: {
        '201': { description: 'Created', content: json(UserSchema) },
        '400': invalid,
        '409': emailTaken,
      },
    }),
  },
  '/users/{id}': {
    get: tagged({
      summary: 'Get a user',
      requestParams: byId,
      responses: { '200': { description: 'The user', content: json(UserSchema) }, '404': notFound },
    }),
    patch: tagged({
      summary: 'Update a user',
      requestParams: byId,
      requestBody: { content: json(UpdateUserSchema) },
      responses: {
        '200': { description: 'The updated user', content: json(UserSchema) },
        '400': invalid,
        '404': notFound,
        '409': emailTaken,
      },
    }),
    delete: tagged({
      summary: 'Delete a user',
      requestParams: byId,
      responses: { '204': { description: 'Deleted' }, '404': notFound },
    }),
  },
};
",
  "src/modules/users/users.repository.ts": "import { isValidObjectId, mongo, type Types } from 'mongoose';
import { UserModel } from './users.model';
import { EmailTakenError, type User, type UsersRepository } from './users.schema';

interface UserDocument {
  _id: Types.ObjectId;
  email: string;
  name: string;
  createdAt: Date;
  updatedAt: Date;
}

function toUser({ _id, email, name, createdAt, updatedAt }: UserDocument): User {
  return { id: _id.toString(), email, name, createdAt, updatedAt };
}

/** 11000: duplicate key, here the unique email index. */
function isDuplicateKey(error: unknown) {
  return error instanceof mongo.MongoServerError && error.code === 11000;
}

export const usersRepository: UsersRepository = {
  async list({ limit, offset }) {
    const docs = await UserModel.find().sort({ createdAt: 1 }).skip(offset).limit(limit).lean();
    return docs.map(toUser);
  },

  async findById(id) {
    if (!isValidObjectId(id)) return null;
    const doc = await UserModel.findById(id).lean();
    return doc && toUser(doc);
  },

  async create(data) {
    try {
      const doc = await UserModel.create(data);
      return toUser(doc.toObject());
    } catch (error) {
      if (isDuplicateKey(error)) throw new EmailTakenError();
      throw error;
    }
  },

  async update(id, data) {
    if (!isValidObjectId(id)) return null;
    try {
      const doc = await UserModel.findByIdAndUpdate(id, data, {
        new: true,
        runValidators: true,
      }).lean();
      return doc && toUser(doc);
    } catch (error) {
      if (isDuplicateKey(error)) throw new EmailTakenError();
      throw error;
    }
  },

  async remove(id) {
    if (!isValidObjectId(id)) return false;
    return (await UserModel.findByIdAndDelete(id)) !== null;
  },
};
",
  "src/modules/users/users.routes.ts": "import { Router } from 'express';
import { HttpError } from '../../middleware/error-handler';
import { usersRepository } from './users.repository';
import { CreateUserSchema, ListUsersSchema, UpdateUserSchema } from './users.schema';

/** CRUD routes for users. Invalid input throws a ZodError, which the error handler sends as 400. */
export const usersRouter = Router();

const notFound = () => new HttpError(404, 'User not found');

usersRouter.get('/', async (req, res) => {
  res.json(await usersRepository.list(ListUsersSchema.parse(req.query)));
});

usersRouter.post('/', async (req, res) => {
  const user = await usersRepository.create(CreateUserSchema.parse(req.body));
  res.status(201).location(\`\${req.baseUrl}/\${user.id}\`).json(user);
});

usersRouter.get('/:id', async (req, res) => {
  const user = await usersRepository.findById(req.params.id);
  if (!user) throw notFound();
  res.json(user);
});

usersRouter.patch('/:id', async (req, res) => {
  const user = await usersRepository.update(req.params.id, UpdateUserSchema.parse(req.body));
  if (!user) throw notFound();
  res.json(user);
});

usersRouter.delete('/:id', async (req, res) => {
  if (!(await usersRepository.remove(req.params.id))) throw notFound();
  res.status(204).end();
});
",
  "src/modules/users/users.schema.ts": "import { z } from 'zod';

/** Request body for creating a user. */
export const CreateUserSchema = z.object({
  email: z.email().toLowerCase(),
  name: z.string().trim().min(1).max(100),
});

/** Request body for updating a user: any subset of the create fields. */
export const UpdateUserSchema = CreateUserSchema.partial();

/** Query string for listing users. */
export const ListUsersSchema = z.object({
  limit: z.coerce.number().int().min(1).max(100).default(20),
  offset: z.coerce.number().int().min(0).default(0),
});

export type CreateUser = z.infer<typeof CreateUserSchema>;
export type UpdateUser = z.infer<typeof UpdateUserSchema>;
export type ListUsers = z.infer<typeof ListUsersSchema>;

export interface User {
  id: string;
  email: string;
  name: string;
  createdAt: Date;
  updatedAt: Date;
}

/** Storage for users. \`users.repository.ts\` implements it for the chosen database. */
export interface UsersRepository {
  list(query: ListUsers): Promise<User[]>;
  findById(id: string): Promise<User | null>;
  /** Throws \`EmailTakenError\` if the email is already used. */
  create(data: CreateUser): Promise<User>;
  /** Returns null if there is no such user. Throws \`EmailTakenError\` on a duplicate email. */
  update(id: string, data: UpdateUser): Promise<User | null>;
  /** Returns false if there is no such user. */
  remove(id: string): Promise<boolean>;
}

/** Another user already has this email. The error handler sends it as a 409. */
export class EmailTakenError extends Error {
  readonly status = 409;
  readonly expose = true;

  constructor() {
    super('A user with this email already exists');
    this.name = 'EmailTakenError';
  }
}
",
  "src/server.ts": "import { createApp } from './app';
import { env } from './config/env';
import { logger } from './lib/logger';
import { markShuttingDown } from './lib/readiness';
import { connectDatabase, disconnectDatabase } from './db/client';

try {
  await connectDatabase();
} catch (error) {
  logger.fatal({ err: error }, 'Could not connect to the database. Is it running?');
  process.exit(1);
}

const server = createApp().listen(env.PORT, () => {
  logger.info(\`Listening on http://localhost:\${env.PORT}\`);
  // Tells PM2 (wait_ready) that this worker can take traffic.
  process.send?.('ready');
});

let shuttingDown = false;

/** Stop taking new connections, let open requests finish, close resources, then exit. */
function shutdown(reason: string, exitCode = 0) {
  if (shuttingDown) return;
  shuttingDown = true;
  logger.info({ reason }, 'Shutting down');
  markShuttingDown();

  const timer = setTimeout(() => {
    logger.error('Open connections did not close in time, exiting');
    process.exit(1);
  }, env.SHUTDOWN_TIMEOUT_MS);
  timer.unref();

  server.close(async (error) => {
    try {
      await disconnectDatabase();
    } catch (closeError) {
      logger.error({ err: closeError }, 'Error while closing the database');
    }
    if (error) logger.error({ err: error }, 'Error while closing the server');
    process.exit(error ? 1 : exitCode);
  });
}

process.once('SIGTERM', () => shutdown('SIGTERM'));
process.once('SIGINT', () => shutdown('SIGINT'));
process.on('unhandledRejection', (reason) => {
  logger.fatal({ err: reason }, 'Unhandled promise rejection');
  shutdown('unhandledRejection', 1);
});
process.on('uncaughtException', (error) => {
  logger.fatal({ err: error }, 'Uncaught exception');
  shutdown('uncaughtException', 1);
});
",
  "tests/users.test.ts": "import request from 'supertest';
import { beforeEach, describe, expect, it, vi } from 'vitest';
import { createApp } from '../src/app';
import { memoryUsersRepository } from './support/memory-users-repository';

// The routes run against an in-memory repository, so these tests need no database.
vi.mock('../src/modules/users/users.repository', async () => ({
  usersRepository: (await import('./support/memory-users-repository')).memoryUsersRepository,
}));

const app = createApp();
const ada = { email: 'ada@example.com', name: 'Ada Lovelace' };

describe('users', () => {
  beforeEach(() => memoryUsersRepository.reset());

  it('creates, reads, updates and deletes a user', async () => {
    const created = await request(app).post('/users').send(ada);
    expect(created.status).toBe(201);
    expect(created.body).toMatchObject(ada);
    const { id } = created.body;
    expect(created.headers.location).toBe(\`/users/\${id}\`);

    expect((await request(app).get(\`/users/\${id}\`)).body).toMatchObject(ada);
    expect((await request(app).get('/users')).body).toHaveLength(1);

    const updated = await request(app).patch(\`/users/\${id}\`).send({ name: 'Ada King' });
    expect(updated.status).toBe(200);
    expect(updated.body.name).toBe('Ada King');

    expect((await request(app).delete(\`/users/\${id}\`)).status).toBe(204);
    expect((await request(app).get(\`/users/\${id}\`)).status).toBe(404);
  });

  it('rejects an invalid body with 400', async () => {
    const response = await request(app).post('/users').send({ email: 'not-an-email' });

    expect(response.status).toBe(400);
    expect(response.body.error.details.fieldErrors).toHaveProperty('email');
  });

  it('rejects a duplicate email with 409', async () => {
    await request(app).post('/users').send(ada);
    const response = await request(app).post('/users').send(ada);

    expect(response.status).toBe(409);
    expect(response.body.error.message).toMatch(/already exists/);
  });

  it('answers 404 for an unknown id', async () => {
    expect((await request(app).get('/users/unknown')).status).toBe(404);
    expect((await request(app).patch('/users/unknown').send({ name: 'x' })).status).toBe(404);
    expect((await request(app).delete('/users/unknown')).status).toBe(404);
  });
});
",
}
`;

