  "src/modules/auth/auth.routes.ts": "import { fromNodeHeaders } from 'better-auth/node';
import type { FastifyPluginAsync, FastifyRequest, preHandlerAsyncHookHandler } from 'fastify';
import { auth } from '../../lib/auth';
import { HttpError } from '../../middleware/error-handler';

type Session = NonNullable<Awaited<ReturnType<typeof auth.api.getSession>>>;

declare module 'fastify' {
  interface FastifyRequest {
    /** Set by \`requireSession\`. */
    session?: Session;
  }
}

/** Turn a Fastify request into the web \`Request\` Better Auth handles. */
function toWebRequest(request: FastifyRequest) {
  const url = new URL(request.url, \`\${request.protocol}://\${request.host}\`);
  return new Request(url, {
    method: request.method,
    headers: fromNodeHeaders(request.headers),
    ...(request.body !== undefined && { body: JSON.stringify(request.body) }),
  });
}

/** Better Auth's own routes under /api/auth (sign-up, sign-in, sessions, …). */
export const betterAuthRoutes: FastifyPluginAsync = async (app) => {
  app.route({
    method: ['GET', 'POST'],
    url: '/api/auth/*',
    async handler(request, reply) {
      const response = await auth.handler(toWebRequest(request));
      reply.status(response.status);
      response.headers.forEach((value, key) => {
        if (key !== 'set-cookie') reply.header(key, value);
      });
      const cookies = response.headers.getSetCookie();
      if (cookies.length) reply.header('set-cookie', cookies);
      return reply.send(response.body ? await response.text() : null);
    },
  });
};

/** Rejects a request without a valid session (401); the session is in \`request.session\`. */
export const requireSession: preHandlerAsyncHookHandler = async (request) => {
  const session = await auth.api.getSession({ headers: fromNodeHeaders(request.headers) });
  if (!session) throw new HttpError(401, 'Authentication required');
  request.session = session;
};

/** An example protected route: the signed-in user. */
export const authRoutes: FastifyPluginAsync = async (app) => {
  app.get('/me', { preHandler: requireSession }, async (request) => request.session?.user);
};
",
  "src/modules/users/users.schema.ts": "import { z } from 'zod';

/** Request body for creating a user. */
export const CreateUserSchema = z.object({
  email: z.email().toLowerCase(),
  name: z.string().trim().min(1).max(100),
});

/** Request body for updating a user: any subset of the create fields. */
export const UpdateUserSchema = CreateUserSchema.partial();

/** Query string for listing users. */
export const ListUsersSchema = z.object({
  limit: z.coerce.number().int().min(1).max(100).default(20),
  offset: z.coerce.number().int().min(0).default(0),
});

export type CreateUser = z.infer<typeof CreateUserSchema>;
export type UpdateUser = z.infer<typeof UpdateUserSchema>;
export type ListUsers = z.infer<typeof ListUsersSchema>;

export interface User {
  id: string;
  email: string;
  name: string;
  createdAt: Date;
  updatedAt: Date;
}

/** Storage for users. \`users.repository.ts\` implements it for the chosen database. */
export interface UsersRepository {
  list(query: ListUsers): Promise<User[]>;
  findById(id: string): Promise<User | null>;
  /** Throws \`EmailTakenError\` if the email is already used. */
  create(data: CreateUser): Promise<User>;
  /** Returns null if there is no such user. Throws \`EmailTakenError\` on a duplicate email. */
  update(id: string, data: UpdateUser): Promise<User | null>;
  /** Returns false if there is no such user. */
  remove(id: string): Promise<boolean>;
}

/** Another user already has this email. The error handler sends it as a 409. */
export class EmailTakenError extends Error {
  readonly status = 409;
  readonly expose = true;

  constructor() {
    super('A user with this email already exists');
    this.name = 'EmailTakenError';
  }
}
",
