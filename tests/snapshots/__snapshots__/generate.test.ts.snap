  "src/app.ts": "import { randomUUID } from 'node:crypto';
import cors from 'cors';
import express from 'express';
import { rateLimit } from 'express-rate-limit';
import helmet from 'helmet';
import { pinoHttp } from 'pino-http';
import { env } from './config/env';
import { logger } from './lib/logger';
import { errorHandler, notFound } from './middleware/error-handler';
import { healthRouter } from './modules/health/health.routes';
import { docsRouter } from './modules/docs/docs.routes';
import { toNodeHandler } from 'better-auth/node';
import { auth } from './lib/auth';
import { authRouter } from './modules/auth/auth.routes';
import { usersRouter } from './modules/users/users.routes';

/** Build the app without listening, so tests can drive it directly. */
export function createApp() {
  const app = express();

  app.use(
    pinoHttp({
      logger,
      // Reuse an incoming X-Request-Id (from a proxy) or create one, and echo it back.
      genReqId: (req, res) => {
        const id = req.headers['x-request-id']?.toString() || randomUUID();
        res.setHeader('x-request-id', id);
        return id;
      },
      autoLogging: { ignore: (req) => req.url === '/health' || req.url === '/ready' },
    }),
  );
  app.use(helmet());
  // Health checks stay outside CORS and rate limiting.
  app.use(healthRouter);

  app.use(cors({ origin: env.CORS_ORIGIN === '*' ? '*' : env.CORS_ORIGIN.split(',') }));
  app.use(
    rateLimit({
      windowMs: 60_000,
      limit: env.RATE_LIMIT_PER_MINUTE,
      standardHeaders: 'draft-8',
      legacyHeaders: false,
    }),
  );
  // Better Auth reads the raw body, so it goes before the JSON parser.
  app.all('/api/auth/{*splat}', toNodeHandler(auth));
  app.use(express.json({ limit: env.BODY_LIMIT_KB * 1024 }));

  app.use(docsRouter);
  app.use('/auth', authRouter);
  app.use('/users', usersRouter);
  app.use(notFound);
  app.use(errorHandler);

  return app;
}
",
  "src/db/auth-adapter.ts": "import { mongodbAdapter } from 'better-auth/adapters/mongodb';
import { MongoClient } from 'mongodb';
import { env } from '../config/env';

// Better Auth talks to MongoDB through the driver directly, with its own small pool. The client
// connects on first use, so importing this needs no running database.
const client = new MongoClient(env.DATABASE_URL);

/**
 * Better Auth stores its users, sessions and accounts in the auth* collections. Transactions need
 * a replica set, which the compose \`mongo\` service isn't; turn them on if your server is one.
 */
export const authDatabase = mongodbAdapter(client.db(), { client, transaction: false });

export async function closeAuthDatabase() {
  await client.close();
}
",
