  RATE_LIMIT_PER_MINUTE: z.coerce.number().int().positive().default(100),
  BODY_LIMIT_KB: z.coerce.number().int().positive().default(100),
  DATABASE_URL: z.url({ protocol: /^postgres(ql)?$/ }),
});

const parsed = EnvSchema.safeParse(process.env);
if (!parsed.success) {
  console.error(\`Invalid environment variables:\\n\${z.prettifyError(parsed.error)}\`);
  process.exit(1);
}

export const env = parsed.data;
export type Env = typeof env;
",
  "src/lib/logger.ts": "import { pino } from 'pino';
import { env } from '../config/env';

const defaultLevel = { development: 'debug', test: 'silent', production: 'info' } as const;

/** Pretty output in development, JSON lines everywhere else. */
export const logger = pino({
  level: env.LOG_LEVEL ?? defaultLevel[env.NODE_ENV],
  redact: ['req.headers.authorization', 'req.headers.cookie', 'res.headers["set-cookie"]'],
  ...(env.NODE_ENV === 'development' && { transport: { target: 'pino-pretty' } }),
});
",
  "src/lib/readiness.ts": "/** A dependency the app needs before it can serve traffic (database, cache, …). */
export interface ReadinessCheck {
  name: string;
  check: () => Promise<void>;
}

const checks: ReadinessCheck[] = [];

/** Register a dependency check, e.g. from the module that opens a database connection. */
export function addReadinessCheck(name: string, check: () => Promise<void>) {
  checks.push({ name, check });
}

let shuttingDown = false;

/** Called on SIGTERM so load balancers stop sending traffic before the server closes. */
export function markShuttingDown() {
  shuttingDown = true;
}

/** Run every check. \`ready\` is false while shutting down or if any check fails. */
export async function readiness() {
  if (shuttingDown) return { ready: false, checks: { shutdown: 'shutting down' } };

  const results = await Promise.allSettled(checks.map(({ check }) => check()));
  const report = Object.fromEntries(
    checks.map(({ name }, index) => [
      name,
      results[index]?.status === 'fulfilled' ? 'ok' : 'failing',
    ]),
  );
  return { ready: Object.values(report).every((status) => status === 'ok'), checks: report };
}
",
  "src/middleware/error-handler.ts": "import type { FastifyReply, FastifyRequest } from 'fastify';
import { z } from 'zod';

/** Throw this from a handler to send a specific status and message. */
export class HttpError extends Error {
  constructor(
    readonly status: number,
    message: string,
    readonly details?: unknown,
  ) {
    super(message);
    this.name = 'HttpError';
  }
}

export function notFound(request: FastifyRequest, reply: FastifyReply) {
  const path = request.url.split('?')[0];
  void reply.status(404).send({
    error: { message: \`Cannot \${request.method} \${path}\`, requestId: request.id },
  });
}

/** Status of an error that is safe to show: Fastify's own 4xx (bad JSON, …) or \`expose\`. */
function exposedStatus(error: unknown): number | undefined {
  if (typeof error !== 'object' || error === null) return undefined;
  if ('statusCode' in error && typeof error.statusCode === 'number' && error.statusCode < 500) {
    return error.statusCode;
  }
  if ('status' in error && typeof error.status === 'number' && 'expose' in error) {
    return error.expose === true ? error.status : undefined;
  }
  return undefined;
}

/** One JSON error shape for everything. 5xx details are logged, never sent to the client. */
export function errorHandler(error: unknown, request: FastifyRequest, reply: FastifyReply) {
  let status = 500;
  let message = 'Internal Server Error';
  let details: unknown;

  const exposed = exposedStatus(error);
  if (error instanceof HttpError) {
    ({ status, message, details } = error);
  } else if (error instanceof z.ZodError) {
    status = 400;
    message = 'Validation failed';
    details = z.flattenError(error);
  } else if (exposed !== undefined && error instanceof Error) {
    status = exposed;
    message = error.message;
  }

  if (status >= 500) request.log.error({ err: error }, 'Request failed');

  void reply.status(status).send({ error: { message, details, requestId: request.id } });
}
",
  "src/modules/docs/docs.routes.ts": "import scalar from '@scalar/fastify-api-reference';
import type { FastifyPluginAsync } from 'fastify';
import { docsContentSecurityPolicy } from '../../openapi/docs-page';
import { openApiDocument } from '../../openapi/document';

/** The OpenAPI document at /openapi.json and interactive API docs (Scalar) at /docs. */
export const docsRoutes: FastifyPluginAsync = async (app) => {
  // Runs after helmet's hook (this plugin is encapsulated), so these routes get the docs CSP.
  app.addHook('onRequest', async (_request, reply) => {
    reply.header('content-security-policy', docsContentSecurityPolicy);
  });

  app.get('/openapi.json', async () => openApiDocument);

  await app.register(scalar, { routePrefix: '/docs', configuration: { url: '/openapi.json' } });
};
",
  "src/modules/health/health.routes.ts": "import type { FastifyPluginAsync } from 'fastify';
import { readiness } from '../../lib/readiness';

// Probes are frequent: keep them out of the logs and the rate limit.
const probe = { logLevel: 'silent', config: { rateLimit: false } } as const;

export const healthRoutes: FastifyPluginAsync = async (app) => {
  /** Liveness: the process is up. Used by the Docker HEALTHCHECK. */
  app.get('/health', probe, async () => ({ status: 'ok' }));

  /** Readiness: dependencies are reachable and the app isn't shutting down. */
  app.get('/ready', probe, async (_request, reply) => {
    const result = await readiness();
    return reply.status(result.ready ? 200 : 503).send(result);
  });
};
",
  "src/modules/users/users.openapi.ts": "import { z } from 'zod';
import type { ZodOpenApiOperationObject, ZodOpenApiPathsObject } from 'zod-openapi';
import { errorResponse, json } from '../../openapi/schemas';
import { CreateUserSchema, ListUsersSchema, UpdateUserSchema } from './users.schema';

const UserSchema = z
  .object({
    id: z.string(),
    email: z.email(),
    name: z.string(),
    createdAt: z.iso.datetime(),
    updatedAt: z.iso.datetime(),
  })
  .meta({ id: 'User' });

const byId = { path: z.object({ id: z.string() }) };
const notFound = errorResponse('No user with this id');
const invalid = errorResponse('Invalid request body or query');
const emailTaken = errorResponse('Another user already has this email');

const tagged = (operation: ZodOpenApiOperationObject) => ({ tags: ['users'], ...operation });

/** OpenAPI paths for the users routes, added to the document in src/openapi/document.ts. */
export const usersPaths: ZodOpenApiPathsObject = {
  '/users': {
    get: tagged({
      summary: 'List users',
      requestParams: { query: ListUsersSchema },
      responses: {
        '200': { description: 'A page of users', content: json(z.array(UserSchema)) },
        '400': invalid,
      },
    }),
    post: tagged({
      summary: 'Create a user',
      requestBody: { content: json(CreateUserSchema) },
      responses: {
        '201': { description: 'Created', content: json(UserSchema) },
        '400': invalid,
        '409': emailTaken,
      },
    }),
  },
  '/users/{id}': {
    get: tagged({
      summary: 'Get a user',
      requestParams: byId,
      responses: { '200': { description: 'The user', content: json(UserSchema) }, '404': notFound },
    }),
    patch: tagged({
      summary: 'Update a user',
      requestParams: byId,
      requestBody: { content: json(UpdateUserSchema) },
      responses: {
        '200': { description: 'The updated user', content: json(UserSchema) },
        '400': invalid,
        '404': notFound,
        '409': emailTaken,
      },
    }),
    delete: tagged({
      summary: 'Delete a user',
      requestParams: byId,
      responses: { '204': { description: 'Deleted' }, '404': notFound },
    }),
  },
};
",
  "src/modules/users/users.repository.ts": "import { prisma } from '../../db/client';
import { Prisma } from '../../generated/prisma/client';
import { EmailTakenError, type UsersRepository } from './users.schema';

/** P2002: unique constraint failed (the email). P2025: the record to change doesn't exist. */
function isPrismaError(error: unknown, code: string) {
  return error instanceof Prisma.PrismaClientKnownRequestError && error.code === code;
}

export const usersRepository: UsersRepository = {
  list: ({ limit, offset }) =>
    prisma.user.findMany({ orderBy: { createdAt: 'asc' }, take: limit, skip: offset }),

  findById: (id) => prisma.user.findUnique({ where: { id } }),

  async create(data) {
    try {
      return await prisma.user.create({ data });
    } catch (error) {
      if (isPrismaError(error, 'P2002')) throw new EmailTakenError();
      throw error;
    }
  },

  async update(id, data) {
    try {
      return await prisma.user.update({ where: { id }, data });
    } catch (error) {
      if (isPrismaError(error, 'P2025')) return null;
      if (isPrismaError(error, 'P2002')) throw new EmailTakenError();
      throw error;
    }
  },

  async remove(id) {
    const { count } = await prisma.user.deleteMany({ where: { id } });
    return count > 0;
  },
};
",
  "src/modules/users/users.routes.ts": "import type { FastifyPluginAsync } from 'fastify';
import { HttpError } from '../../middleware/error-handler';
import { usersRepository } from './users.repository';
import { CreateUserSchema, ListUsersSchema, UpdateUserSchema } from './users.schema';

/** CRUD routes for users. Invalid input throws a ZodError, which the error handler sends as 400. */
export const usersRoutes: FastifyPluginAsync = async (app) => {
  const notFound = () => new HttpError(404, 'User not found');

  app.get('/', async (request) => usersRepository.list(ListUsersSchema.parse(request.query)));

  app.post('/', async (request, reply) => {
    const user = await usersRepository.create(CreateUserSchema.parse(request.body));
    return reply.status(201).header('location', \`\${app.prefix}/\${user.id}\`).send(user);
  });

  app.get<{ Params: { id: string } }>('/:id', async (request) => {
    const user = await usersRepository.findById(request.params.id);
    if (!user) throw notFound();
    return user;
  });

  app.patch<{ Params: { id: string } }>('/:id', async (request) => {
    const data = UpdateUserSchema.parse(request.body ?? {});
    const user = await usersRepository.update(request.params.id, data);
    if (!user) throw notFound();
    return user;
  });

  app.delete<{ Params: { id: string } }>('/:id', async (request, reply) => {
    if (!(await usersRepository.remove(request.params.id))) throw notFound();
    return reply.status(204).send();
  });
};
",
  "src/modules/users/users.schema.ts": "import { z } from 'zod';

/** Request body for creating a user. */
export const CreateUserSchema = z.object({
  email: z.email().toLowerCase(),
  name: z.string().trim().min(1).max(100),
});

/** Request body for updating a user: any subset of the create fields. */
export const UpdateUserSchema = CreateUserSchema.partial();

/** Query string for listing users. */
export const ListUsersSchema = z.object({
  limit: z.coerce.number().int().min(1).max(100).default(20),
  offset: z.coerce.number().int().min(0).default(0),
});

export type CreateUser = z.infer<typeof CreateUserSchema>;
export type UpdateUser = z.infer<typeof UpdateUserSchema>;
export type ListUsers = z.infer<typeof ListUsersSchema>;

export interface User {
  id: string;
  email: string;
  name: string;
  createdAt: Date;
  updatedAt: Date;
}

/** Storage for users. \`users.repository.ts\` implements it for the chosen database. */
export interface UsersRepository {
  list(query: ListUsers): Promise<User[]>;
  findById(id: string): Promise<User | null>;
  /** Throws \`EmailTakenError\` if the email is already used. */
  create(data: CreateUser): Promise<User>;
  /** Returns null if there is no such user. Throws \`EmailTakenError\` on a duplicate email. */
  update(id: string, data: UpdateUser): Promise<User | null>;
  /** Returns false if there is no such user. */
  remove(id: string): Promise<boolean>;
}

/** Another user already has this email. The error handler sends it as a 409. */
export class EmailTakenError extends Error {
  readonly status = 409;
  readonly expose = true;

  constructor() {
    super('A user with this email already exists');
    this.name = 'EmailTakenError';
  }
}
",
  "src/openapi/docs-page.ts": "/**
 * The Scalar docs page loads its script from a pinned CDN version and runs a small inline
 * script, so /docs gets this Content-Security-Policy instead of the strict default.
 */
export const scalarCdn = 'https://cdn.jsdelivr.net/npm/@scalar/api-reference@1.73.1';

export const docsContentSecurityPolicy = [
  "default-src 'self'",
  "script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net",
  "style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://fonts.scalar.com",
  "font-src 'self' data: https://fonts.scalar.com",
  "img-src 'self' data: https:",
  "connect-src 'self'",
].join('; ');
",
  "src/openapi/document.ts": "import { z } from 'zod';
import { createDocument } from 'zod-openapi';
import { json } from './schemas';
import { usersPaths } from '../modules/users/users.openapi';

const ReadinessSchema = z.object({
  ready: z.boolean(),
  checks: z.record(z.string(), z.string()),
});

/**
 * The OpenAPI 3.1 description of this API, built from Zod schemas. Served at /openapi.json and
 * rendered at /docs. Add each new route's paths here.
 */
export const openApiDocument = createDocument({
  openapi: '3.1.0',
  info: { title: 'my-api', version: '0.1.0' },
  paths: {
    '/health': {
      get: {
        tags: ['health'],
        summary: 'Liveness: the process is up',
        responses: {
          '200': { description: 'Up', content: json(z.object({ status: z.literal('ok') })) },
        },
      },
    },
    '/ready': {
      get: {
        tags: ['health'],
        summary: 'Readiness: dependencies are reachable',
        responses: {
          '200': { description: 'Ready', content: json(ReadinessSchema) },
          '503': { description: 'Not ready', content: json(ReadinessSchema) },
        },
      },
    },
    ...usersPaths,
  },
});
",
  "src/openapi/schemas.ts": "import { z } from 'zod';

/** The body every error response has (see the error handler). */
export const ErrorSchema = z
  .object({
    error: z.object({
      message: z.string(),
      requestId: z.string().optional(),
      details: z.unknown().optional(),
    }),
  })
  .meta({ id: 'Error' });

/** A JSON response or request body with this schema. */
export const json = (schema: z.ZodType) => ({ 'application/json': { schema } });

/** An error response with this description. */
export const errorResponse = (description: string) => ({
  description,
  content: json(ErrorSchema),
});
",
  "src/server.ts": "import { createApp } from './app';
import { env } from './config/env';
import { logger } from './lib/logger';
import { markShuttingDown } from './lib/readiness';
import { connectDatabase, disconnectDatabase } from './db/client';

try {
  await connectDatabase();
} catch (error) {
  logger.fatal({ err: error }, 'Could not connect to the database. Is it running?');
  process.exit(1);
}

const app = createApp();
// 0.0.0.0 so the server is reachable from outside a container; Fastify defaults to localhost.
await app.listen({ port: env.PORT, host: '0.0.0.0' });
// Tells PM2 (wait_ready) that this worker can take traffic.
process.send?.('ready');

let shuttingDown = false;

/** Stop taking new connections, let open requests finish, close resources, then exit. */
async function shutdown(reason: string, exitCode = 0) {
  if (shuttingDown) return;
  shuttingDown = true;
  logger.info({ reason }, 'Shutting down');
  markShuttingDown();

  const timer = setTimeout(() => {
    logger.error('Open connections did not close in time, exiting');
    process.exit(1);
  }, env.SHUTDOWN_TIMEOUT_MS);
  timer.unref();

  let failed = false;
  try {
    await app.close();
  } catch (error) {
    failed = true;
    logger.error({ err: error }, 'Error while closing the server');
  }
  try {
    await disconnectDatabase();
  } catch (closeError) {
    logger.error({ err: closeError }, 'Error while closing the database');
  }
  process.exit(failed ? 1 : exitCode);
}

process.once('SIGTERM', () => void shutdown('SIGTERM'));
process.once('SIGINT', () => void shutdown('SIGINT'));
process.on('unhandledRejection', (reason) => {
  logger.fatal({ err: reason }, 'Unhandled promise rejection');
  void shutdown('unhandledRejection', 1);
});
process.on('uncaughtException', (error) => {
  logger.fatal({ err: error }, 'Uncaught exception');
  void shutdown('uncaughtException', 1);
});
",
  "tests/app.test.ts": "import { describe, expect, it } from 'vitest';
import { createApp } from '../src/app';

describe('app', () => {
  it('returns a JSON 404 with the request id', async () => {
    const response = await createApp().inject({ method: 'GET', url: '/nope' });

    expect(response.statusCode).toBe(404);
    expect(response.json().error).toMatchObject({ message: 'Cannot GET /nope' });
    expect(response.json().error.requestId).toBe(response.headers['x-request-id']);
  });

  it('reuses an incoming X-Request-Id', async () => {
    const response = await createApp().inject({
      method: 'GET',
      url: '/health',
      headers: { 'x-request-id': 'abc-123' },
    });

    expect(response.headers['x-request-id']).toBe('abc-123');
  });

  it('sets security headers', async () => {
    const response = await createApp().inject({ method: 'GET', url: '/health' });

    expect(response.headers['x-content-type-options']).toBe('nosniff');
    expect(response.headers['x-powered-by']).toBeUndefined();
  });
});
",
  "tests/docs.test.ts": "import { describe, expect, it } from 'vitest';
import { createApp } from '../src/app';

describe('API docs', () => {
  it('GET /openapi.json serves the OpenAPI document', async () => {
    const response = await createApp().inject('/openapi.json');

    expect(response.statusCode).toBe(200);
    expect(response.json()).toMatchObject({ openapi: '3.1.0', paths: { '/health': {} } });
  });

  it('GET /docs/ serves the Scalar page', async () => {
    const response = await createApp().inject('/docs/');

    expect(response.statusCode).toBe(200);
    expect(response.headers['content-type']).toMatch(/^text\\/html/);
    expect(response.headers['content-security-policy']).toContain("'unsafe-inline'");
  });
});
